# =====================================================================
# Stock adjustments — /api/v1/stock-adjustments
# Staff: create, read, revisi (hanya pembuatnya). Supervisor: read, approve, reject.
# Superadmin: semua. Data dibatasi gudang milik user (WarehouseScope).
# Status: pending -> approved (stok berubah) | rejected -> revisi -> pending lagi.
# Stok HANYA berubah saat approve; stok tidak cukup = 422 dan semua rollback.
# Tipe: stock_opname & correction boleh +/-, damaged_goods & lost_goods hanya -.
# Jalankan dulu: semua login, "Cari WH-MALANG-01", "Cari WH-SURABAYA-01",
# "List lokasi warehouse" (Surabaya), "Cari produk LP-001", lalu 2 request
# persiapan di bawah. Alur A/B/C bisa diulang (nomor ADJ baru tiap create).
# =====================================================================

### Persiapan: list lokasi WH-MALANG-01 — data[0] RAK-A-01, data[1] RAK-A-02
# @name locMalang
GET {{baseUrl}}/api/v1/warehouses/{{whMalang.response.body.$.data[0].id}}/locations
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Persiapan: cari produk TB-001 (seeder)
# @name productTb001
GET {{baseUrl}}/api/v1/products?search=TB-001
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

# ---- Alur A: stock opname -> revisi -> approve ----

