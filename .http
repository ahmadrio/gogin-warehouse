# Port diambil dari .env (APP_PORT) agar selalu sinkron dengan config.Load()
@baseUrl = http://localhost:{{$dotenv APP_PORT}}
# Password default semua user hasil seeder (cmd/seed)
@password = password123

### Health check — cek server & koneksi database
GET {{baseUrl}}/health
Accept: application/json

### Login superadmin — akses semua gudang
# Token dipakai request /auth/me di bawah: {{login.response.body.$.data.access_token}}
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "superadmin@warehouse.test",
  "password": "{{password}}"
}

### Login supervisor — akses WH-MALANG-01 & WH-SURABAYA-01
# @name loginSupervisor
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "supervisor@warehouse.test",
  "password": "{{password}}"
}

### Login staff Malang — akses WH-MALANG-01 saja
# @name loginStaffMalang
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "staff.malang@warehouse.test",
  "password": "{{password}}"
}

### Login staff Surabaya — akses WH-SURABAYA-01 saja
# @name loginStaffSurabaya
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "staff.surabaya@warehouse.test",
  "password": "{{password}}"
}

### Login gagal: password salah — harapan 401 "email atau password salah"
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "superadmin@warehouse.test",
  "password": "salah-password"
}

### Login gagal: validasi — harapan 422 dengan errors.email & errors.password
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "bukan-email",
  "password": ""
}

# =====================================================================
# Route terproteksi — lewat middleware.Authenticate
# Jalankan request login yang sesuai dulu agar token-nya tersedia.
# =====================================================================

### Me superadmin — harapan 200, all_warehouses true
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Me supervisor — harapan 200, warehouse_ids berisi 2 gudang
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{loginSupervisor.response.body.$.data.access_token}}

### Me staff Malang — harapan 200, warehouse_ids berisi WH-MALANG-01 saja
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

### Me staff Surabaya — harapan 200, warehouse_ids berisi WH-SURABAYA-01 saja
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer {{loginStaffSurabaya.response.body.$.data.access_token}}

### Me gagal: tanpa header Authorization — harapan 401 "token tidak ditemukan"
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json

### Me gagal: tanpa prefix "Bearer " — harapan 401 "token tidak ditemukan"
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: {{login.response.body.$.data.access_token}}

### Me gagal: token rusak — harapan 401 "token tidak valid atau sudah kedaluwarsa"
GET {{baseUrl}}/api/v1/auth/me
Accept: application/json
Authorization: Bearer ini.bukan.jwt

# =====================================================================
# Product categories — /api/v1/product-categories
# Read: semua role. Create/Update/Delete: superadmin saja.
# Urutan jalankan: Create -> Get/Update -> Delete (bisa diulang, kode
# kategori yang sudah dihapus boleh dipakai lagi).
# =====================================================================

### List kategori — harapan 200, data + meta (page, per_page, total, total_pages)
GET {{baseUrl}}/api/v1/product-categories?page=1&per_page=15
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List kategori dengan search — cocokkan code/name (ILIKE)
GET {{baseUrl}}/api/v1/product-categories?search=elek
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Create kategori — harapan 201, is_active default true
# ID-nya dipakai request di bawah: {{createCategory.response.body.$.data.id}}
# @name createCategory
POST {{baseUrl}}/api/v1/product-categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "ELEKTRONIK",
  "name": "Elektronik",
  "description": "Barang elektronik rumah tangga"
}

### Get kategori by id — harapan 200
GET {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get kategori sebagai staff — harapan 200 (staff punya product_categories:read)
GET {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

### Update kategori — harapan 200, is_active wajib dikirim
PUT {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "ELEKTRONIK",
  "name": "Elektronik & Gadget",
  "description": "Elektronik rumah tangga dan gadget",
  "is_active": false
}

### Create kategori gagal: kode duplikat — harapan 409 "kode kategori sudah dipakai"
POST {{baseUrl}}/api/v1/product-categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "ELEKTRONIK",
  "name": "Elektronik Lagi"
}

### Create kategori gagal: validasi — harapan 422 dengan errors.code & errors.name
POST {{baseUrl}}/api/v1/product-categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "",
  "name": ""
}

### Update kategori gagal: tanpa is_active — harapan 422 dengan errors.is_active
PUT {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "ELEKTRONIK",
  "name": "Elektronik"
}

### Create kategori gagal: staff — harapan 403 "anda tidak memiliki akses: product_categories:create"
POST {{baseUrl}}/api/v1/product-categories
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

{
  "code": "MAKANAN",
  "name": "Makanan"
}

### Delete kategori gagal: supervisor — harapan 403 "anda tidak memiliki akses: product_categories:delete"
DELETE {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{loginSupervisor.response.body.$.data.access_token}}

### Get kategori gagal: id bukan UUID — harapan 400 "id harus berupa UUID"
GET {{baseUrl}}/api/v1/product-categories/123
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get kategori gagal: UUID tidak ada — harapan 404 "kategori produk tidak ditemukan"
GET {{baseUrl}}/api/v1/product-categories/{{$guid}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Delete kategori — harapan 204 (soft delete)
DELETE {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get kategori setelah dihapus — harapan 404 "kategori produk tidak ditemukan"
GET {{baseUrl}}/api/v1/product-categories/{{createCategory.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

# =====================================================================
# Products — /api/v1/products
# Read: semua role. Create/Update/Delete: superadmin saja.
# Kategori produk harus ada & aktif; dipakai kategori ELK dari seeder.
# Urutan jalankan: Cari kategori ELK -> Create -> Get/Update -> Delete
# (bisa diulang, SKU produk yang sudah dihapus boleh dipakai lagi).
# Delete produk yang masih punya stok -> 409; contohnya ada di section
# Stock adjustments (setelah approve).
# =====================================================================

### Cari kategori ELK (seeder) — ID-nya dipakai request produk di bawah
# @name catElk
GET {{baseUrl}}/api/v1/product-categories?search=ELK
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List produk — harapan 200, minimal 3 produk seeder (LP-001, MJ-001, TB-001) urut SKU
GET {{baseUrl}}/api/v1/products?page=1&per_page=15
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List produk dengan search — cocokkan sku/name (ILIKE)
GET {{baseUrl}}/api/v1/products?search=laptop
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List produk per kategori — harapan 200, hanya produk kategori ELK
GET {{baseUrl}}/api/v1/products?category_id={{catElk.response.body.$.data[0].id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Cari produk LP-001 (seeder) — ID-nya dipakai section Stocks
# @name productLp001
GET {{baseUrl}}/api/v1/products?search=LP-001
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List produk gagal: category_id bukan UUID — harapan 400 "category_id harus berupa UUID"
GET {{baseUrl}}/api/v1/products?category_id=elk
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Create produk — harapan 201, is_active default true, product_category ikut tampil
# ID-nya dipakai request di bawah: {{createProduct.response.body.$.data.id}}
# @name createProduct
POST {{baseUrl}}/api/v1/products
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "product_category_id": "{{catElk.response.body.$.data[0].id}}",
  "sku": "HP-001",
  "name": "Smartphone 6 inch",
  "description": "Smartphone layar 6 inch",
  "unit": "pcs",
  "minimum_stock": 10
}

### Get produk by id — harapan 200
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get produk sebagai staff — harapan 200 (staff punya products:read)
GET {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

### Update produk — harapan 200, is_active wajib dikirim
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "product_category_id": "{{catElk.response.body.$.data[0].id}}",
  "sku": "HP-001",
  "name": "Smartphone 6 inch (dus)",
  "description": "Smartphone layar 6 inch, 1 dus isi 10",
  "unit": "box",
  "minimum_stock": 3,
  "is_active": false
}

### Create produk gagal: SKU duplikat — harapan 409 "SKU sudah dipakai"
POST {{baseUrl}}/api/v1/products
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "product_category_id": "{{catElk.response.body.$.data[0].id}}",
  "sku": "LP-001",
  "name": "Laptop Duplikat",
  "unit": "pcs"
}

### Update produk gagal: SKU milik produk lain — harapan 409 "SKU sudah dipakai"
PUT {{baseUrl}}/api/v1/products/{{createProduct.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "product_category_id": "{{catElk.response.body.$.data[0].id}}",
  "sku": "LP-001",
  "name": "Smartphone 6 inch",
  "unit": "pcs",
  "is_active": true
}

