# =====================================================================
# Inbounds — /api/v1/inbounds (barang masuk dari supplier)
# Staff: create, read, revisi (hanya pembuatnya), putaway. Supervisor: read,
# approve, reject. Superadmin: semua. Data dibatasi gudang milik user (WarehouseScope).
# Status: pending -> approved -> completed (putaway) | rejected -> revisi -> pending lagi.
# Rak TIDAK dikirim saat create. Approve juga belum mengubah stok; stok baru
# bertambah saat putaway, yaitu saat staff menentukan rak untuk SETIAP item.
# Jalankan dulu: semua login, "Cari WH-MALANG-01", "Cari WH-SURABAYA-01",
# "List lokasi warehouse" (Surabaya), "Cari produk LP-001", dan 2 request
# persiapan di section Stock adjustments. Alur bisa diulang (nomor INB baru tiap create).
# =====================================================================

# ---- Alur A: terima barang -> revisi -> approve -> putaway (staff Surabaya) ----

### Create in-bound (staff Surabaya) — harapan 201, status pending, reference_number INB-YYYYMM-NNNN, warehouse_location_id item null
# @name createInbound
POST {{baseUrl}}/api/v1/inbounds
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginStaffSurabaya.response.body.$.data.access_token}}

{
  "warehouse_id": "{{whSurabaya.response.body.$.data[0].id}}",
  "purchase_order_number": "PO-2026-10-001",
  "notes": "Kiriman supplier PT Sumber Elektronik",
  "items": [
    {
      "product_id": "{{productLp001.response.body.$.data[0].id}}",
      "quantity": 30,
      "notes": "Dus segel"
    },
    {
      "product_id": "{{productTb001.response.body.$.data[0].id}}",
      "quantity": 15
    }
  ]
}

