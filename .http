# =====================================================================
# Warehouse locations — /api/v1/warehouses/:id/locations/:location_id
# Read: semua role (dibatasi WarehouseScope). Create/Update/Delete: superadmin saja.
# Kode lokasi unik per gudang. Jalankan "Cari WH-SURABAYA-01" di section
# Warehouses dulu. Urutan: Create -> Get/Update -> Delete (bisa diulang).
# Delete lokasi yang masih berisi barang -> 409; belum bisa dicoba karena
# endpoint transaksi stok belum ada.
# =====================================================================

### Cari WH-MALANG-01 — dipakai untuk uji lokasi milik gudang lain
# @name whMalang
GET {{baseUrl}}/api/v1/warehouses?search=WH-MALANG-01
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Create lokasi di WH-SURABAYA-01 — harapan 201, is_active default true
# ID-nya dipakai request di bawah: {{createLocation.response.body.$.data.id}}
# @name createLocation
POST {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "RAK-B-04",
  "name": "Rak RAK-B-04",
  "description": "Rak barang elektronik kecil"
}

### Get lokasi by id — harapan 200
GET {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get lokasi sebagai staff Surabaya — harapan 200 (WH-SURABAYA-01 ada di scope-nya)
GET {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{loginStaffSurabaya.response.body.$.data.access_token}}

### Update lokasi — harapan 200, is_active wajib dikirim
PUT {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "RAK-B-04",
  "name": "Rak RAK-B-04 (Elektronik)",
  "description": "Rak barang elektronik kecil, lantai 2",
  "is_active": false
}

### Create lokasi gagal: kode duplikat di gudang yang sama — harapan 409 "kode lokasi sudah dipakai di warehouse ini"
POST {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "RAK-B-01",
  "name": "Rak Duplikat"
}

### Update lokasi gagal: kode milik lokasi lain — harapan 409 "kode lokasi sudah dipakai di warehouse ini"
PUT {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "RAK-B-01",
  "name": "Rak RAK-B-04",
  "is_active": true
}

### Create lokasi gagal: validasi — harapan 422 dengan errors.code & errors.name
POST {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "description": "Tanpa kode dan nama"
}

### Update lokasi gagal: tanpa is_active — harapan 422 dengan errors.is_active
PUT {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

{
  "code": "RAK-B-04",
