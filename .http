### Create lokasi gagal: supervisor — harapan 403 "anda tidak memiliki akses: warehouse_locations:create"
POST {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginSupervisor.response.body.$.data.access_token}}

{
  "code": "RAK-B-05",
  "name": "Rak RAK-B-05"
}

### Get lokasi gagal: staff Malang buka gudang Surabaya — harapan 404 "warehouse tidak ditemukan"
GET {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

### Get lokasi gagal: lokasi Surabaya dibuka lewat gudang Malang — harapan 404 "lokasi tidak ditemukan"
GET {{baseUrl}}/api/v1/warehouses/{{whMalang.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get lokasi gagal: location_id bukan UUID — harapan 400 "location_id harus berupa UUID"
GET {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/rak-b-04
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Delete lokasi — harapan 204 (soft delete)
DELETE {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### Get lokasi setelah dihapus — harapan 404 "lokasi tidak ditemukan"
GET {{baseUrl}}/api/v1/warehouses/{{whSurabaya.response.body.$.data[0].id}}/locations/{{createLocation.response.body.$.data.id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

# =====================================================================
# Stocks — /api/v1/stocks (saldo per lokasi & produk, hanya quantity > 0)
# Filter opsional: warehouse_id, location_id, product_id, search (sku/name).
# Data dibatasi gudang milik user (WarehouseScope), urut SKU lalu kode lokasi.
# Endpoint transaksi stok belum ada, jadi saat ini data masih kosong (total 0).
# Jalankan "Cari WH-SURABAYA-01", "List lokasi warehouse", dan
# "Cari produk LP-001" dulu agar ID filternya tersedia.
# =====================================================================

### List stok superadmin — harapan 200, data + meta (page, per_page, total, total_pages)
GET {{baseUrl}}/api/v1/stocks?page=1&per_page=15
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok per gudang — WH-SURABAYA-01
GET {{baseUrl}}/api/v1/stocks?warehouse_id={{whSurabaya.response.body.$.data[0].id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok per lokasi — RAK-B-01
GET {{baseUrl}}/api/v1/stocks?location_id={{locSurabaya.response.body.$.data[0].id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok per produk — LP-001 di semua gudang
GET {{baseUrl}}/api/v1/stocks?product_id={{productLp001.response.body.$.data[0].id}}
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok kombinasi filter + search — LP-001 di WH-SURABAYA-01
GET {{baseUrl}}/api/v1/stocks?warehouse_id={{whSurabaya.response.body.$.data[0].id}}&search=laptop
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok gagal: warehouse_id bukan UUID — harapan 400 "warehouse_id harus berupa UUID"
GET {{baseUrl}}/api/v1/stocks?warehouse_id=WH-MALANG-01
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok gagal: product_id bukan UUID — harapan 400 "product_id harus berupa UUID"
GET {{baseUrl}}/api/v1/stocks?product_id=LP-001
Accept: application/json
Authorization: Bearer {{login.response.body.$.data.access_token}}

### List stok supervisor — saat ini 403 "anda tidak memiliki akses: stocks:read"
# Role supervisor & staff belum diberi stocks:read di auth.RoleDefinisions.
GET {{baseUrl}}/api/v1/stocks
Accept: application/json
Authorization: Bearer {{loginSupervisor.response.body.$.data.access_token}}

### List stok staff Malang — saat ini 403 "anda tidak memiliki akses: stocks:read"
GET {{baseUrl}}/api/v1/stocks
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}
