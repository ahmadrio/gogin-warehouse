# =====================================================================
# Stock transfers — /api/v1/stock-transfers (pindah rak di dalam SATU gudang)
# Staff: create, read, revisi (hanya pembuatnya). Supervisor: read, approve, reject.
# Superadmin: semua. Data dibatasi gudang milik user (WarehouseScope).
# Status: pending -> approved | rejected -> revisi -> pending lagi.
# Saat approve, tiap item = keluar dari rak asal + masuk ke rak tujuan dalam satu
# transaksi; total stok produk di gudang tidak berubah (BR-007).
# Rak asal & rak tujuan harus milik gudang yang sama dan tidak boleh sama.
# Memakai stok WH-MALANG-01 hasil section Stock adjustments; prasyaratnya sama
# dengan section Inbounds. Alur bisa diulang (nomor TRF baru tiap create).
# =====================================================================

# ---- Alur A: pindah rak -> revisi -> approve ----

### Create transfer (staff Malang) — harapan 201, status pending, reference_number TRF-YYYYMM-NNNN
# @name createTransfer
POST {{baseUrl}}/api/v1/stock-transfers
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{loginStaffMalang.response.body.$.data.access_token}}

{
  "warehouse_id": "{{whMalang.response.body.$.data[0].id}}",
  "notes": "Rapikan rak, barang laris dipindah ke RAK-A-03",
  "items": [
    {
      "product_id": "{{productLp001.response.body.$.data[0].id}}",
      "source_warehouse_location_id": "{{locMalang.response.body.$.data[0].id}}",
      "destination_warehouse_location_id": "{{locMalang.response.body.$.data[2].id}}",
      "quantity": 10,
      "notes": "Dekat pintu keluar"
    },
    {
      "product_id": "{{productTb001.response.body.$.data[0].id}}",
      "source_warehouse_location_id": "{{locMalang.response.body.$.data[1].id}}",
      "destination_warehouse_location_id": "{{locMalang.response.body.$.data[2].id}}",
      "quantity": 5
    }
  ]
}

